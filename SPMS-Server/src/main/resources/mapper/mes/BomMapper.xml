<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  BOM 主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；明细是 @ManyToMany，
  不在这里 JOIN。parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.mes.bom.mapper.BomMapper">

    <resultMap id="bomReadMap" type="cn.hamm.spms.module.mes.bom.BomEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
    </resultMap>

    <sql id="bomColumns">
        b.id,
        b.create_time,
        b.update_time,
        b.is_disabled,
        b.is_published,
        b.tenant_id,
        b.creator_id,
        b.code,
        b.name,
        b.status,
        b.type
    </sql>

    <sql id="bomFilter">
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND b.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND b.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.type != null">
            AND b.type = #{filter.type}
        </if>
        <if test="filter != null and filter.status != null">
            AND b.status = #{filter.status}
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="bomReadMap">
        SELECT
        <include refid="bomColumns"/>
        FROM bom b
        <where>
            <include refid="bomFilter"/>
        </where>
        ORDER BY b.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="bomReadMap">
        SELECT
        <include refid="bomColumns"/>
        FROM bom b
        WHERE b.id = #{id}
    </select>

    <select id="selectForExport" resultMap="bomReadMap">
        SELECT
        <include refid="bomColumns"/>
        FROM bom b
        <where>
            <include refid="bomFilter"/>
        </where>
        ORDER BY b.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM bom b
        <where>
            <include refid="bomFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN b.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM bom b
        <where>
            <include refid="bomFilter"/>
        </where>
    </select>

</mapper>
