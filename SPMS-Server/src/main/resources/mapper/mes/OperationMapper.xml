<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  工序主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；工序单表无关联主表。
  parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.mes.operation.mapper.OperationMapper">

    <resultMap id="operationReadMap" type="cn.hamm.spms.module.mes.operation.OperationEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
    </resultMap>

    <sql id="operationColumns">
        o.id,
        o.create_time,
        o.update_time,
        o.is_disabled,
        o.is_published,
        o.tenant_id,
        o.creator_id,
        o.name,
        o.code
    </sql>

    <sql id="operationFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND o.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND o.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
    </sql>

    <sql id="operationParityFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="operationReadMap">
        SELECT
        <include refid="operationColumns"/>
        FROM operation o
        <where>
            <include refid="operationFilter"/>
        </where>
        ORDER BY o.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="operationReadMap">
        SELECT
        <include refid="operationColumns"/>
        FROM operation o
        WHERE o.id = #{id}
    </select>

    <select id="selectForExport" resultMap="operationReadMap">
        SELECT
        <include refid="operationColumns"/>
        FROM operation o
        <where>
            <include refid="operationFilter"/>
        </where>
        ORDER BY o.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM operation o
        <where>
            <include refid="operationFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN o.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM operation o
        <where>
            <include refid="operationFilter"/>
        </where>
    </select>

    <select id="countByPermissionFragment" resultType="long">
        SELECT COUNT(1) FROM operation
        <where>
            <include refid="operationParityFilter"/>
            <if test="fragment != null and fragment != ''">
                AND ${fragment}
            </if>
        </where>
    </select>

</mapper>
