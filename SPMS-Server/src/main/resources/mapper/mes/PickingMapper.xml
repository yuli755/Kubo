<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 领料单主表读 SQL；权限条件由 MyBatis-Plus 追加，关联对象只投影 ID。 -->
<mapper namespace="cn.hamm.spms.module.mes.picking.mapper.PickingMapper">
    <resultMap id="pickingReadMap" type="cn.hamm.spms.module.mes.picking.PickingEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="bill_code" property="billCode"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
        <association property="structure" javaType="cn.hamm.spms.module.factory.structure.StructureEntity">
            <id column="structure_id" property="id"/>
        </association>
        <association property="order" javaType="cn.hamm.spms.module.mes.order.OrderEntity">
            <id column="order_id" property="id"/>
        </association>
    </resultMap>

    <sql id="pickingColumns">
        p.id,
        p.create_time,
        p.update_time,
        p.is_disabled,
        p.is_published,
        p.tenant_id,
        p.creator_id,
        p.reject_reason,
        p.bill_code,
        p.status,
        p.type,
        p.structure_id,
        p.order_id
    </sql>

    <sql id="pickingFilter">
        <if test="billCode != null and billCode != ''">
            AND p.bill_code LIKE CONCAT('%', #{billCode}, '%')
        </if>
        <if test="status != null">
            AND p.status = #{status}
        </if>
        <if test="type != null">
            AND p.type = #{type}
        </if>
    </sql>

    <sql id="pickingParityFilter">
        <if test="billCode != null and billCode != ''">
            AND bill_code LIKE CONCAT('%', #{billCode}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="type != null">
            AND type = #{type}
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="pickingReadMap">
        SELECT <include refid="pickingColumns"/>
        FROM picking p
        <where><include refid="pickingFilter"/></where>
        ORDER BY p.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="pickingReadMap">
        SELECT <include refid="pickingColumns"/>
        FROM picking p
        WHERE p.id = #{id}
    </select>

    <select id="selectForExport" resultMap="pickingReadMap">
        SELECT <include refid="pickingColumns"/>
        FROM picking p
        <where><include refid="pickingFilter"/></where>
        ORDER BY p.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM picking p
        <where><include refid="pickingFilter"/></where>
    </select>

    <select id="countByPermissionFragment" resultType="long">
        SELECT COUNT(1) FROM picking
        <where>
            <include refid="pickingParityFilter"/>
            <if test="fragment != null and fragment != ''">AND ${fragment}</if>
        </where>
    </select>
</mapper>
