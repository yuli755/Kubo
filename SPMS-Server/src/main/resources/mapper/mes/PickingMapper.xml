<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 权限片段只来自 SqlPermissionRuleRenderer；${fragment} 后仍由 #{} 参数化。 -->
<mapper namespace="cn.hamm.spms.module.mes.picking.mapper.PickingMapper">
    <select id="countByPermissionFragment" resultType="long">
        SELECT COUNT(1) FROM picking
        <where>
            <if test="fragment != null and fragment != ''">
                ${fragment}
            </if>
        </where>
    </select>
</mapper>
