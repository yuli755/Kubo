<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 生产计划主表读 SQL；权限条件由 MyBatis-Plus 追加，客户关系只投影 ID。 -->
<mapper namespace="cn.hamm.spms.module.mes.plan.mapper.PlanMapper">
    <resultMap id="planReadMap" type="cn.hamm.spms.module.mes.plan.PlanEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="bill_code" property="billCode"/>
        <result column="status" property="status"/>
        <result column="type" property="type"/>
        <result column="deliver_time" property="deliverTime"/>
        <result column="start_time" property="startTime"/>
        <result column="finish_time" property="finishTime"/>
        <association property="customer" javaType="cn.hamm.spms.module.channel.customer.CustomerEntity">
            <id column="customer_id" property="id"/>
        </association>
    </resultMap>

    <sql id="planColumns">
        p.id,
        p.create_time,
        p.update_time,
        p.is_disabled,
        p.is_published,
        p.tenant_id,
        p.creator_id,
        p.reject_reason,
        p.bill_code,
        p.status,
        p.type,
        p.deliver_time,
        p.start_time,
        p.finish_time,
        p.customer_id
    </sql>

    <sql id="planFilter">
        <if test="billCode != null and billCode != ''">
            AND p.bill_code LIKE CONCAT('%', #{billCode}, '%')
        </if>
        <if test="status != null">
            AND p.status = #{status}
        </if>
        <if test="type != null">
            AND p.type = #{type}
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="planReadMap">
        SELECT <include refid="planColumns"/>
        FROM plan p
        <where><include refid="planFilter"/></where>
        ORDER BY p.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="planReadMap">
        SELECT <include refid="planColumns"/>
        FROM plan p
        WHERE p.id = #{id}
    </select>

    <select id="selectForExport" resultMap="planReadMap">
        SELECT <include refid="planColumns"/>
        FROM plan p
        <where><include refid="planFilter"/></where>
        ORDER BY p.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM plan p
        <where><include refid="planFilter"/></where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN p.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM plan p
        <where><include refid="planFilter"/></where>
    </select>

</mapper>
