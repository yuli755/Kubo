<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  生产工艺主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；material/bom 关联只投影 ID，
  工序配置列表（@Transient）不在这里加载。parity statement 不使用别名。
-->
<mapper namespace="cn.hamm.spms.module.mes.routing.mapper.RoutingMapper">

    <resultMap id="routingReadMap" type="cn.hamm.spms.module.mes.routing.RoutingEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="is_routing_bom" property="isRoutingBom"/>
        <association property="material" javaType="cn.hamm.spms.module.asset.material.MaterialEntity">
            <id column="material_id" property="id"/>
        </association>
        <association property="bom" javaType="cn.hamm.spms.module.mes.bom.BomEntity">
            <id column="bom_id" property="id"/>
        </association>
    </resultMap>

    <sql id="routingColumns">
        r.id,
        r.create_time,
        r.update_time,
        r.is_disabled,
        r.is_published,
        r.tenant_id,
        r.creator_id,
        r.code,
        r.name,
        r.status,
        r.is_routing_bom,
        r.material_id,
        r.bom_id
    </sql>

    <sql id="routingFilter">
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND r.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND r.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.status != null">
            AND r.status = #{filter.status}
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="routingReadMap">
        SELECT
        <include refid="routingColumns"/>
        FROM routing r
        <where>
            <include refid="routingFilter"/>
        </where>
        ORDER BY r.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="routingReadMap">
        SELECT
        <include refid="routingColumns"/>
        FROM routing r
        WHERE r.id = #{id}
    </select>

    <select id="selectForExport" resultMap="routingReadMap">
        SELECT
        <include refid="routingColumns"/>
        FROM routing r
        <where>
            <include refid="routingFilter"/>
        </where>
        ORDER BY r.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM routing r
        <where>
            <include refid="routingFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN r.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM routing r
        <where>
            <include refid="routingFilter"/>
        </where>
    </select>

</mapper>
