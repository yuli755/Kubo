    <insert id="insertFactoryListByOwnerIds">
        insert into user_factory (user_entity_id, factory_id) values
        <foreach collection="targetIds" item="targetId" separator=",">(#{ownerId}, #{targetId})</foreach>
    </insert>

</mapper>
