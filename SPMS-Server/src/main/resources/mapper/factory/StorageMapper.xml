<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  仓库主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；树导航（children）走 JPA getList，
  不在这里递归。parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.factory.storage.mapper.StorageMapper">

    <resultMap id="storageReadMap" type="cn.hamm.spms.module.factory.storage.StorageEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
    </resultMap>

    <sql id="storageColumns">
        s.id,
        s.create_time,
        s.update_time,
        s.is_disabled,
        s.is_published,
        s.tenant_id,
        s.creator_id,
        s.code,
        s.name,
        s.parent_id
    </sql>

    <sql id="storageFilter">
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND s.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND s.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="storageReadMap">
        SELECT
        <include refid="storageColumns"/>
        FROM storage s
        <where>
            <include refid="storageFilter"/>
        </where>
        ORDER BY s.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="storageReadMap">
        SELECT
        <include refid="storageColumns"/>
        FROM storage s
        WHERE s.id = #{id}
    </select>

    <select id="selectForExport" resultMap="storageReadMap">
        SELECT
        <include refid="storageColumns"/>
        FROM storage s
        <where>
            <include refid="storageFilter"/>
        </where>
        ORDER BY s.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM storage s
        <where>
            <include refid="storageFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN s.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM storage s
        <where>
            <include refid="storageFilter"/>
        </where>
    </select>

</mapper>
