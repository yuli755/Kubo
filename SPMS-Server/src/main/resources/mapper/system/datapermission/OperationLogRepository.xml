<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  来自 OperationLogRepository（数据权限证据/审计日志族）。
  2026-09-18 SQL 分层：语句一律住专属文件，Java 侧只留方法声明。
  这些表"业务失败也要留痕"，所以仓储在无条件注册的 Mapper 族里（KuboInfraMapper）。
-->
<mapper namespace="cn.hamm.spms.module.system.datapermission.repository.OperationLogRepository">

    <resultMap id="baseMap" type="cn.hamm.spms.module.system.datapermission.entity.OperationLogEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="resource_key" property="resourceKey"/>
        <result column="action" property="action"/>
        <result column="user_id" property="userId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="target_id" property="targetId"/>
        <result column="target_label" property="targetLabel"/>
        <result column="before_snapshot" property="beforeSnapshot"/>
        <result column="after_snapshot" property="afterSnapshot"/>
    </resultMap>
    <sql id="baseColumns">
        id, create_time, update_time, is_disabled, is_published, resource_key, action, user_id, tenant_id, target_id, target_label, before_snapshot, after_snapshot
    </sql>

    <select id="findTop200ByOrderByIdDesc" resultMap="baseMap">
        select <include refid="baseColumns"/>
        from operation_log
        order by id desc
        limit 200
    </select>

    <select id="findTop200ByResourceKeyOrderByIdDesc" resultMap="baseMap">
        select <include refid="baseColumns"/>
        from operation_log
        where resource_key = #{resourceKey}
        order by id desc
        limit 200
    </select>

    <delete id="deleteExpiredBefore">
        delete from operation_log where create_time &lt; #{cutoff}
    </delete>

</mapper>
