<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  写侧仓储 ContractRepository 的专属语句（2026-09-18 J2 去 JPA 时新增）。

  为什么必须有这条 selectByIdForUpdate：ContractEntity 的加锁读（引擎 getForUpdate）靠它。
  "锁住这一行"只能是 SQL，而本仓的 SQL 分层规则要求可执行 SQL 住在 mapper XML 里，
  所以它不写成 wrapper.last("FOR UPDATE")（那是把 SQL 塞回 Java）。

  flushCache="true" 不是优化而是正确性：同一事务里重复调用必须真的再发一次 SQL，
  否则 MyBatis 的会话本地缓冲会把第二次调用变成"读缓存" —— 锁没加、读到旧值，而且不报错。
  它替代的正是 JPA 时代的 entityManager.clear()。
-->
<mapper namespace="cn.hamm.spms.module.asset.contract.ContractRepository">

    <select id="selectByIdForUpdate" flushCache="true" resultType="cn.hamm.spms.module.asset.contract.ContractEntity">
        select *
        from contract
        where id = #{id}
        for update
    </select>

    <!--
      多对多中间表的三条语句（J3）：关系集合不是本表的列，MyBatis-Plus 的内置语句碰不到它。
      读用 DocumentListPairs（一次拿整页的"属主 → 目标"ID 对，再由 RelationHydrator 批量取目标实体）；
      写用"先删后插"，语义与 JPA 时代把集合设到托管实体上再 flush 一致
      （集合为 null 表示这次没提交它 = 一行不动）。
      表名与列名按 init.sql 的口径（Hibernate 隐式命名：<属主表>_<字段名>_list）。
    -->
    <select id="selectDocumentListPairs" resultType="java.util.Map">
        select contract_entity_id as ownerId, document_list_id as targetId
        from contract_document_list
        where contract_entity_id in
        <foreach collection="ownerIds" item="ownerId" open="(" separator="," close=")">#{ownerId}</foreach>
    </select>

    <delete id="deleteDocumentListByOwnerId">
        delete from contract_document_list where contract_entity_id = #{ownerId}
    </delete>

    <insert id="insertDocumentListByOwnerIds">
        insert into contract_document_list (contract_entity_id, document_list_id) values
        <foreach collection="targetIds" item="targetId" separator=",">(#{ownerId}, #{targetId})</foreach>
    </insert>

    <!--
      多对多中间表的三条语句（J3）：关系集合不是本表的列，MyBatis-Plus 的内置语句碰不到它。
      读用 ParticipantListPairs（一次拿整页的"属主 → 目标"ID 对，再由 RelationHydrator 批量取目标实体）；
      写用"先删后插"，语义与 JPA 时代把集合设到托管实体上再 flush 一致
      （集合为 null 表示这次没提交它 = 一行不动）。
      表名与列名按 init.sql 的口径（Hibernate 隐式命名：<属主表>_<字段名>_list）。
    -->
    <select id="selectParticipantListPairs" resultType="java.util.Map">
        select contract_entity_id as ownerId, participant_list_id as targetId
        from contract_participant_list
        where contract_entity_id in
        <foreach collection="ownerIds" item="ownerId" open="(" separator="," close=")">#{ownerId}</foreach>
    </select>

    <delete id="deleteParticipantListByOwnerId">
        delete from contract_participant_list where contract_entity_id = #{ownerId}
    </delete>

    <insert id="insertParticipantListByOwnerIds">
        insert into contract_participant_list (contract_entity_id, participant_list_id) values
        <foreach collection="targetIds" item="targetId" separator=",">(#{ownerId}, #{targetId})</foreach>
    </insert>

</mapper>
