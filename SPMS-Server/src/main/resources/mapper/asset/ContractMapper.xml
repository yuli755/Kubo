<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  合同主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；附件/参与方是 @ManyToMany，
  不在这里 JOIN。parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.asset.contract.mapper.ContractMapper">

    <resultMap id="contractReadMap" type="cn.hamm.spms.module.asset.contract.ContractEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="content" property="content"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="contractColumns">
        c.id,
        c.create_time,
        c.update_time,
        c.is_disabled,
        c.is_published,
        c.tenant_id,
        c.creator_id,
        c.code,
        c.name,
        c.content,
        c.start_time,
        c.end_time,
        c.type,
        c.status
    </sql>

    <sql id="contractFilter">
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND c.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND c.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.content != null and filter.content != ''">
            AND c.content LIKE CONCAT('%', #{filter.content}, '%')
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="contractReadMap">
        SELECT
        <include refid="contractColumns"/>
        FROM contract c
        <where>
            <include refid="contractFilter"/>
        </where>
        ORDER BY c.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="contractReadMap">
        SELECT
        <include refid="contractColumns"/>
        FROM contract c
        WHERE c.id = #{id}
    </select>

    <select id="selectForExport" resultMap="contractReadMap">
        SELECT
        <include refid="contractColumns"/>
        FROM contract c
        <where>
            <include refid="contractFilter"/>
        </where>
        ORDER BY c.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM contract c
        <where>
            <include refid="contractFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN c.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM contract c
        <where>
            <include refid="contractFilter"/>
        </where>
    </select>

</mapper>
