<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  供应商读侧语句。权限条件由 MyBatis-Plus 按 statement ID 追加；供应商无跨资源关联主表。
  parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.channel.supplier.mapper.SupplierMapper">

    <resultMap id="supplierReadMap" type="cn.hamm.spms.module.channel.supplier.SupplierEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="phone" property="phone"/>
    </resultMap>

    <sql id="supplierColumns">
        s.id,
        s.create_time,
        s.update_time,
        s.is_disabled,
        s.is_published,
        s.tenant_id,
        s.creator_id,
        s.name,
        s.code,
        s.phone
    </sql>

    <sql id="supplierFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND s.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND s.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
    </sql>

    <sql id="supplierParityFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="supplierReadMap">
        SELECT
        <include refid="supplierColumns"/>
        FROM supplier s
        <where>
            <include refid="supplierFilter"/>
        </where>
        ORDER BY s.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="supplierReadMap">
        SELECT
        <include refid="supplierColumns"/>
        FROM supplier s
        WHERE s.id = #{id}
    </select>

    <select id="selectForExport" resultMap="supplierReadMap">
        SELECT
        <include refid="supplierColumns"/>
        FROM supplier s
        <where>
            <include refid="supplierFilter"/>
        </where>
        ORDER BY s.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM supplier s
        <where>
            <include refid="supplierFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN s.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM supplier s
        <where>
            <include refid="supplierFilter"/>
        </where>
    </select>

    <select id="countByPermissionFragment" resultType="long">
        SELECT COUNT(1) FROM supplier
        <where>
            <include refid="supplierParityFilter"/>
            <if test="fragment != null and fragment != ''">
                AND ${fragment}
            </if>
        </where>
    </select>

</mapper>
