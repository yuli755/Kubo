<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  销售单主表读出口。权限条件由 MyBatis-Plus 按 statement ID 追加；明细不在这里 JOIN。
  客户关联只投影 ID，详情阶段由 Service 沿客户服务补齐。parity statement 不使用别名。
-->
<mapper namespace="cn.hamm.spms.module.channel.sale.mapper.SaleMapper">

    <resultMap id="saleReadMap" type="cn.hamm.spms.module.channel.sale.SaleEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="bill_code" property="billCode"/>
        <result column="reason" property="reason"/>
        <result column="total_price" property="totalPrice"/>
        <result column="status" property="status"/>
        <association property="customer" javaType="cn.hamm.spms.module.channel.customer.CustomerEntity">
            <id column="customer_id" property="id"/>
        </association>
    </resultMap>

    <sql id="saleColumns">
        s.id,
        s.create_time,
        s.update_time,
        s.is_disabled,
        s.is_published,
        s.tenant_id,
        s.creator_id,
        s.reject_reason,
        s.bill_code,
        s.reason,
        s.total_price,
        s.status,
        s.customer_id
    </sql>

    <sql id="saleFilter">
        <if test="billCode != null and billCode != ''">
            AND s.bill_code LIKE CONCAT('%', #{billCode}, '%')
        </if>
        <if test="reason != null and reason != ''">
            AND s.reason LIKE CONCAT('%', #{reason}, '%')
        </if>
        <if test="status != null">
            AND s.status = #{status}
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="saleReadMap">
        SELECT
        <include refid="saleColumns"/>
        FROM sale s
        <where>
            <include refid="saleFilter"/>
        </where>
        ORDER BY s.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="saleReadMap">
        SELECT
        <include refid="saleColumns"/>
        FROM sale s
        WHERE s.id = #{id}
    </select>

    <select id="selectForExport" resultMap="saleReadMap">
        SELECT
        <include refid="saleColumns"/>
        FROM sale s
        <where>
            <include refid="saleFilter"/>
        </where>
        ORDER BY s.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM sale s
        <where>
            <include refid="saleFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN s.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM sale s
        <where>
            <include refid="saleFilter"/>
        </where>
    </select>

</mapper>
