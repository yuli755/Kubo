<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  客户读侧语句。权限条件由 MyBatis-Plus 按 statement ID 追加；客户无跨资源关联主表。
  parity statement 不使用别名，保证 renderer 使用的物理表限定名与 SQL 一致。
-->
<mapper namespace="cn.hamm.spms.module.channel.customer.mapper.CustomerMapper">

    <resultMap id="customerReadMap" type="cn.hamm.spms.module.channel.customer.CustomerEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="creator_id" property="creatorId"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="phone" property="phone"/>
    </resultMap>

    <sql id="customerColumns">
        c.id,
        c.create_time,
        c.update_time,
        c.is_disabled,
        c.is_published,
        c.tenant_id,
        c.creator_id,
        c.name,
        c.code,
        c.phone
    </sql>

    <sql id="customerFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND c.name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND c.code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.phone != null and filter.phone != ''">
            AND c.phone LIKE CONCAT('%', #{filter.phone}, '%')
        </if>
    </sql>

    <sql id="customerParityFilter">
        <if test="filter != null and filter.name != null and filter.name != ''">
            AND name LIKE CONCAT('%', #{filter.name}, '%')
        </if>
        <if test="filter != null and filter.code != null and filter.code != ''">
            AND code LIKE CONCAT('%', #{filter.code}, '%')
        </if>
        <if test="filter != null and filter.phone != null and filter.phone != ''">
            AND phone LIKE CONCAT('%', #{filter.phone}, '%')
        </if>
    </sql>

    <select id="selectPageByPermission" resultMap="customerReadMap">
        SELECT
        <include refid="customerColumns"/>
        FROM customer c
        <where>
            <include refid="customerFilter"/>
        </where>
        ORDER BY c.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectDetailByPermission" resultMap="customerReadMap">
        SELECT
        <include refid="customerColumns"/>
        FROM customer c
        WHERE c.id = #{id}
    </select>

    <select id="selectForExport" resultMap="customerReadMap">
        SELECT
        <include refid="customerColumns"/>
        FROM customer c
        <where>
            <include refid="customerFilter"/>
        </where>
        ORDER BY c.id DESC
    </select>

    <select id="countByPermission" resultType="long">
        SELECT COUNT(1)
        FROM customer c
        <where>
            <include refid="customerFilter"/>
        </where>
    </select>

    <select id="statByPermission" resultType="cn.hamm.spms.base.mapper.ReadStat">
        SELECT
            COUNT(1) AS total,
            COALESCE(SUM(CASE WHEN c.is_published THEN 1 ELSE 0 END), 0) AS published_total
        FROM customer c
        <where>
            <include refid="customerFilter"/>
        </where>
    </select>

    <select id="countByPermissionFragment" resultType="long">
        SELECT COUNT(1) FROM customer
        <where>
            <include refid="customerParityFilter"/>
            <if test="fragment != null and fragment != ''">
                AND ${fragment}
            </if>
        </where>
    </select>

</mapper>
