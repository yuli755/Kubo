<configuration>
    <property name="pattern"
              value="%d{yyyy-MM-dd HH:mm:ss} [TRACE_ID=%X{X-Trace-ID}] [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="log.path" value="./"/>
    <property name="log.name" value="kubo-server"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${pattern}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/${log.name}.log</file>
        <encoder>
            <pattern>${pattern}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 每天滚动，并按大小分割 -->
            <fileNamePattern>${log.path}/${log.name}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>256MB</maxFileSize>
            <!-- P2：排障窗口 1 天偏短（事故常需回溯一周），改为 7 天；单文件与总量随之收紧，
                 在「排障能力」与「磁盘占用」之间取平衡（生产 P3 已关包体日志，日志量显著下降）。 -->
            <maxHistory>7</maxHistory>
            <!-- 总日志大小上限 3GB（原 10GB 对生产磁盘是隐性占用） -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
