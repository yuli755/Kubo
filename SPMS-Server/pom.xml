<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      2026-09-18（退场 B0）：**不再继承 cn.hamm:airpower 父 POM**。
      原父 POM 给这个工程的东西只有四样，现在全部自持：
        1. 构建基线：Java 17 / UTF-8 源码编码（下面的 properties）；
        2. 依赖版本表：import spring-boot-dependencies 3.4.4（原父 POM 同样是 import 这个 BOM，
           而不是继承 spring-boot-starter-parent —— 所以这里**保持同构**：只 import BOM，
           不引入 starter-parent 的插件管理与资源过滤，行为零变化）；
        3. 两个属性：`airpower.version`（airpower-curd 的版本，退场期间仍需）与
           `springboot.version`（spring-boot-maven-plugin 的版本）；
        4. 发布用 build 插件（source / javadoc / gpg / central-publishing）—— 那是
           airpower 发版用的，应用工程从来不需要，摘掉正好。
      自持之后，Spring Boot 的版本由**这个文件**决定，而不由第三方父 POM 决定。
      离线校验：`pnpm pom:check`（无版本依赖必须在 BOM 家族白名单内、`${...}` 属性必须在本 POM 内有定义）。
    -->
    <groupId>cn.hamm.spms</groupId>
    <artifactId>server</artifactId>
    <version>4.0.0</version>
    <name>Kubo</name>
    <description>Kubo Smart Production Management System</description>
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <properties>
        <!-- ==================== 构建基线（原父 POM 提供，现自持） ==================== -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
          Spring Boot 版本：原由 cn.hamm:airpower 父 POM 的 ${springboot.version} 决定（3.4.4），
          现在写在这里。改成新版本 = 只动这一行（不再受第三方父 POM 牵制）。
        -->
        <springboot.version>3.4.4</springboot.version>

        <!--
          P2 读链路换轨的地基版本（§19.33）。两个 artifact 必须**同版本**：3.5.9 起 JSqlParser 被拆成
          独立 artifact，只引 starter 不引 jsqlparser 的话，任何 InnerInterceptor（分页 / 我们的数据权限）
          在第一次解析 SQL 时才 NoClassDefFoundError —— 那是"跑到线上第一个列表页才炸"的形状。
          CI 的 Reject forbidden dependencies 会把这条成对规则钉住，不靠人记。
        -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
    </properties>

    <!--
      依赖版本表：只 import Spring Boot 官方 BOM。
      所以本工程里所有 org.springframework.boot / org.springframework / io.micrometer /
      com.h2database / org.flywaydb 与 jackson-databind、lombok 的版本由 BOM 管理；其余显式写版本
      （mybatis-plus、springdoc）。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot 核心原生 Starter（由 spring-boot-dependencies BOM 管理版本，无私有框架依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 内部 JSON 文本编解码由项目直接持有；版本由 Boot 3.4.4 导入的 Jackson BOM 管理。
             不再把这项依赖的存在寄托在待退场的 airpower-core 上，也不改 HTTP ObjectMapper。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 本项目自己的 @Data/@Slf4j 需要编译期处理器；不依赖旧框架的 provided 依赖传递。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          2026-09-28：补回 airpower 父 POM 退场（B0）时遗漏的传递依赖。
          全仓 65 个文件 import org.jetbrains.annotations 的 @NotNull/@Nullable，
          原先由 cn.hamm:airpower 父 POM 传递引入；退场后未重新声明，导致
          146 处「程序包 org.jetbrains.annotations 不存在」编译错误、后端整体构建失败。
          仅编译期需要，故用 provided，不进运行时 classpath。
          版本需显式指定：Spring Boot BOM 不管理该 GA。
        -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>

        <!--
          2026-09-18：airpower-email 已摘除。全仓只有 UserService 用它发邮箱验证码，
          自建的 cn.hamm.spms.common.email.EmailHelper 逐行等价（同样的 HTML 模板、
          同样的 spring.mail.username 发件人、同样的「未配置即报错」语义），
          因此邮件能力改用 Spring Boot 官方的 starter 即可，少一个框架模块。
          版本由父 POM（Spring Boot BOM）管理，不显式写。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- WebAuthn 相关依赖 -->
        <!-- 阿里云OSS开始 -->
        <!-- no more than 2.3.3-->

        <!-- 阿里云OSS结束 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          应用层指标（JVM / HTTP / HikariCP）暴露 /actuator/prometheus，供 Prometheus 抓取（§7.2）。
          版本由 Spring Boot BOM 管理（与 actuator 同源），不显式写版本号。
          生产是否对外暴露由 application-production.yml 的 management.endpoints.web.exposure.include
          控制（默认只 health,info，这里追加 prometheus）。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <!-- H2 数据库用于集成测试 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          MyBatis-Plus（P2 读链路换轨用）。读侧接线由 `kubo.data-permission.mapper-read.enabled`
          条件控制，默认仍关闭：默认上下文没有 @MapperScan、MybatisPlusInterceptor 或读侧 Mapper；
          打开开关的接线与 XML 只服务后端 shadow COUNT/拦截器验证，业务 page/detail/stat/export
          读端点仍按施工图逐资源收口。`MybatisJpaCoexistenceTest` 继续验证默认关闭时两套 ORM
          能共存且回滚位有效。
        -->
        <!--
          2026-09-28：补回 airpower 父 POM 退场（B0）时遗漏的第二个传递依赖 —— MySQL JDBC 驱动。
          原由 cn.hamm:airpower 父 POM 传递引入，退场后未重新声明。
          与 org.jetbrains:annotations 不同的是：没有任何源码 import com.mysql.*，
          所以编译期完全静默，只在运行时炸 —— Hikari 建 DataSource 时
          "Cannot load driver class: com.mysql.cj.jdbc.Driver"，后端根本起不来。
          版本交给 spring-boot-dependencies BOM 管理（3.4.4 → 9.1.0），不写死。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 数据库迁移：此前是 9 个手工 SQL 脚本，靠人对着文档按顺序执行；现在收编为
             db/migration 下的版本化迁移（V1 基线 + V2..V10 存量脚本），由 Flyway 记账。
             存量库用 baseline-on-migrate 记为 baseline 1，不会重放 V1。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- MySQL 方言支持：Flyway 10+ 拆成独立模块，缺了启动即报
             "No database found to handle jdbc:mysql://..." -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- API 文档: SpringDoc OpenAPI 3。版本必须匹配 Spring Boot 3.4：2.6.0 只适配 Boot 3.2/3.3，
             在 Boot 3.4 上构建文档时抛异常，被全局异常处理器包成 500，/v3/api-docs 只剩
             {code,message,data} 包装。原 knife4j 4.5.0 starter 按 springdoc 2.3.0 编译，它重写的
             /v3/api-docs 控制器是当年 500 的直接源头，已移除。
             必须用 -api 而不是 -ui：UI starter 的 SwaggerWebMvcConfigurer 无视
             springdoc.swagger-ui.enabled，始终注册 /swagger-ui/**/*index.html 这类「** 后挂片段」
             模式，Spring 6.2 的 PathPatternParser 判为非法、resourceHandlerMapping 创建失败、整机起不来
             （2.8.15 / 2.9.1 实测）。消费 /v3/api-docs JSON 即可，见 docs/API_DOCS_GUIDE.md。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>2.9.1</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${springboot.version}</version>
                <configuration>
                    <mainClass>cn.hamm.spms.Application</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  版本必须显式钉死（2026-10-03）：不写版本时 Maven 3.8.3（见 .mvn/wrapper）
                  的 super POM 把 compiler 插件解析到 **3.1**，而 <parameters> 选项是 3.6.0
                  才引入的 —— 3.1 会静默忽略下面这行 <parameters>true</parameters>，
                  于是上面整段注释所防范的 500 又原样复发（真机复现：enforce-readiness /
                  deny-logs 报 "Name for argument ... not specified"，javap 命中 0 处
                  MethodParameters）。3.13.0 = Spring Boot 3.4.4 官方 parent 所管理的版本。
                -->
                <version>3.13.0</version>
                <configuration>
                    <!--
                      【B0 退役 airpower 时丢失的第三处配置，也是唯一在运行期才暴露的一处 —— 现予还原】

                      Spring Boot 3 / Spring Framework 6.1 起，`@RequestParam` / `@PathVariable`
                      未写显式 name 时，参数名绑定**完全依赖编译期写入的参数名元数据**：
                      6.1 已删除 `LocalVariableTableParameterNameDiscoverer`，不再回退到调试信息。
                      缺 `-parameters` 时，编译通过、启动正常、单测通过，但请求一进来就
                      `IllegalArgumentException: Name for argument of type [java.lang.String] not
                      specified, and parameter name information not available via reflection`
                      → HTTP 500，且因为是在 Filter 链内抛出，会**绕过 @RestControllerAdvice**，
                      返回 Spring 默认错误体（timestamp/status/error/path）而非本项目 ApiResponse。

                      实测受影响端点（2026-09-28 真机联调，与 main 注释里的 GUI-2 同一处）：
                        GET /dataResource/operation-logs   getOperationLogs(String resourceKey)   裸形参
                        GET /dataResource/deny-logs        getDenyLogs(String resourceKey)        裸形参
                        GET /dataResource/enforce-readiness getEnforceReadiness(String resourceKey)
                        GET /dataFieldPolicy/my-mask        getMyMask(@RequestParam String ...)   注解无 value
                        GET /dataFieldPolicy/my-mask-map
                        GET /dataFieldPolicy/my-export-visibility

                      为什么 properties 里的自持构建基线没覆盖到它：
                      `maven.compiler.source/target/encoding` 都有同名标准属性，写进 <properties> 即生效；
                      但 `-parameters` **没有任何标准 Maven 属性**，只能落在插件 <configuration> 里。
                      B0 把属性搬过来了，却没意识到还有一块插件配置必须一起搬 —— 于是静默回退了
                      main 上那条带根因注释的 GUI-2 修复。

                      验证方式：javap -v 编译产物应能看到 MethodParameters 属性；
                      缺失时该属性命中数为 0。
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- 必须显式限堆：不设时 fork JVM 按物理内存 1/4 预留，Windows 提交限制
                         （页面文件）不足时 fork 直接以「Error occurred in starting fork」死亡。
                         SerialGC + 限 CodeCache/Metaspace 把 fork 提交量压到 ~0.5GB，
                         紧张的开发机也能跑完整套（Spring 上下文 metaspace 实测 <300m）。 -->
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=512m -XX:ReservedCodeCacheSize=128m</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
