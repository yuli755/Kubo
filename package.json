{
  "name": "kubo-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "author": "Hamm",
  "scripts": {
    "dev": "vite",
    "airpower:check": "node scripts/check-airpower-gone.mjs",
    "airpower:backend": "node infra/scripts/check-airpower-backend.mjs",
    "stack:project": "node scripts/project-stack.mjs",
    "stack": "node scripts/frontend-stack.mjs",
    "deadcode:check": "node scripts/find-unused-frontend.mjs --check",
    "exports:check": "node scripts/find-unused-exports.mjs --check",
    "java:check": "node scripts/java-syntax-check.mjs SPMS-Server/src/main/java SPMS-Server/src/test/java",
    "flyway:baseline": "node scripts/gen-flyway-baseline.mjs",
    "icons:gen": "node scripts/gen-pwa-icons.mjs",
    "lint": "eslint --fix",
    "lint:ci": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "node infra/scripts/check-bundle-size.mjs",
    "size:report": "node infra/scripts/check-bundle-size.mjs --json > dist/size-report.json",
    "perms:check": "node infra/scripts/check-permission-codes.mjs",
    "auth:check": "node infra/scripts/check-endpoint-auth.mjs",
    "text:check": "node infra/scripts/check-source-text.mjs",
    "ddl:check": "node infra/scripts/check-ddl-entity-drift.mjs",
    "migration:check": "node infra/scripts/check-migration-dialect.mjs",
    "monitoring:check": "node infra/scripts/check-monitoring-config.mjs",
    "drill:check": "node infra/scripts/check-backup-drill.mjs",
    "perms:report": "node infra/scripts/check-permission-codes.mjs --verbose",
    "check": "pnpm lint:ci && pnpm airpower:check && pnpm airpower:backend -- --check && pnpm pom:check && pnpm java:imports && pnpm sql:check -- --check && pnpm layer:check -- --check && pnpm jpa:check -- --check && pnpm deadcode:check && pnpm exports:check && pnpm typecheck && pnpm test:coverage && pnpm perms:check && pnpm auth:check && pnpm text:check && pnpm ddl:check && pnpm migration:check && pnpm monitoring:check && pnpm drill:check && pnpm build && pnpm demo:check && pnpm size",
    "build": "vite build --mode production",
    "api:generate": "node infra/scripts/generate-api.mjs",
    "api:generate:dev": "API_DOC_URL=http://localhost:8080/v3/api-docs node infra/scripts/generate-api.mjs",
    "api:generate:prod": "API_DOC_URL=https://api.kubo.example.com/v3/api-docs node infra/scripts/generate-api.mjs",
    "dev:demo": "vite --mode demo",
    "demo:check": "node infra/scripts/check-demo-build.mjs",
    "pom:check": "node infra/scripts/check-pom-selfcontained.mjs",
    "java:imports": "node infra/scripts/check-java-imports.mjs",
    "jpa:check": "node infra/scripts/check-jpa-usage.mjs",
    "sql:check": "node infra/scripts/check-sql-in-java.mjs",
    "layer:check": "node infra/scripts/check-layering.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tanstack/vue-query": "^5.101.4",
    "axios": "1.20.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.12.0",
    "flatted": "^3.4.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@types/node": "22",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.2",
    "jsdom": "^30.0.1",
    "openapi-typescript-codegen": "^0.29.0",
    "sass": "^1.96.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.8"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "js-yaml": "^4.3.2"
    }
  }
}
