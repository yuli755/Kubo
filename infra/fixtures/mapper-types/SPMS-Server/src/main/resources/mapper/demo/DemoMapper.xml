<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="demo.DemoMapper">
    <resultMap id="demoReadMap" type="demo.DeletedEntity">
        <association property="legacy" javaType="demo.gone.LegacyEntity">
            <id column="legacy_id" property="id"/>
        </association>
    </resultMap>

    <select id="selectOne" resultMap="demoReadMap">
        select id from demo where id = #{id}
    </select>
</mapper>
