# =============================================================================
# Kubo 生产环境变量示例配置
# 部署前请复制为 .env：cp .env.production.example .env 并替换所有密码凭据！
# =============================================================================

# 1. 外部暴露端口
WEB_PORT=80

# 2. 数据库配置 (MySQL 8.0)
MYSQL_ROOT_PASSWORD=Kubo_Root_StrongPass_2026_ChangeMe!
MYSQL_DATABASE=kubo
MYSQL_USER=kubo
MYSQL_PASSWORD=Kubo_User_StrongPass_2026_ChangeMe!

# 3. 缓存配置 (Redis 7.2)
REDIS_PASSWORD=Kubo_Redis_StrongPass_2026_ChangeMe!

# 4. JWT 强随机安全密钥（至少 32 字符十六进制，可通过 openssl rand -hex 32 生成）
JWT_SECRET=f4a8b79e1c3d2e5b6a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a

# 5. 数据权限运行档位（off: 紧急回滚 | shadow: 灰度观察打点 | enforce: 强管控拦截）
DATA_PERMISSION_MODE=shadow
