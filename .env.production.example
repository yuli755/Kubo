# =============================================================================
# Kubo 生产环境变量示例配置
# 部署前请复制为 .env：cp .env.production.example .env 并替换所有密码凭据！
# =============================================================================

# 1. 外部暴露端口
WEB_PORT=80

# 2. 数据库配置 (MySQL 8.0)
# 敏感值故意不提供可用默认值；执行 `pnpm docker:env` 生成随机值，或由 Secret Manager 注入。
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env
MYSQL_DATABASE=kubo
MYSQL_USER=kubo
MYSQL_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 3. 缓存配置 (Redis 7.2)
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 4. JWT 强随机安全密钥（执行 `pnpm docker:env` 生成 64 位十六进制值）
JWT_SECRET=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 5. 短信与邮箱注册验证（已有后端接口：/user/sendSms、/user/sendEmail、/user/loginViaEmail）
#    不要提交真实凭据；由 Secret Manager/部署环境注入。未配置真实通道时不要宣称已完成投递验收。
# SMS：当前生产实现为阿里云，需先在阿里云开通签名、模板并完成国内短信资质审核。
SPMS_SMS_PROVIDER=aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=CHANGE_ME_IN_SECRET_MANAGER
ALIBABA_CLOUD_ACCESS_KEY_SECRET=CHANGE_ME_IN_SECRET_MANAGER
SPMS_SMS_ALIYUN_SIGN_NAME=CHANGE_ME_APPROVED_SIGN_NAME
SPMS_SMS_ALIYUN_TEMPLATE_CODE=CHANGE_ME_APPROVED_TEMPLATE_CODE
# 可选：阿里云地域 Endpoint，例如 dysmsapi.aliyuncs.com
SPMS_SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
# Email：SMTP 账号建议使用专用发信账号，密码/授权码必须由 Secret Manager 注入。
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=CHANGE_ME_SMTP_ACCOUNT
SPRING_MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD_OR_APP_TOKEN
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# 6. 数据权限运行档位（零改码档位开关，application-production.yml 显式占位符绑定）
#    shadow  —— 默认档：全量影子比对收集放量证据（当前仓库默认）；
#    enforce —— 放量完成档：白名单 6 资源进入强管控，启动期闸门用真实证据复核；
#    off     —— 紧急回滚档：一键关闭全部拦截，恢复旧行为（无需改代码重新构建）。
DATA_PERMISSION_MODE=shadow
# 当前生产资源名单中有实际 ENFORCE 资源，必须 fail-closed 并禁止无租户回落默认租户。
# 禁止设为 false，除非先将 DATA_PERMISSION_MODE=shadow 且清空 enforce-resources 并经门禁验证。
DATA_PERMISSION_TENANT_REQUIRED=true

# 6. 异步导出保留策略（Redis 状态与磁盘文件都必须有上限）
#    默认任务状态保留 1 小时、导出文件保留 1 天；按真实合规要求调整，必须为正数。
SPMS_EXPORT_TASK_TTL_SECONDS=3600
SPMS_EXPORT_FILE_RETENTION_DAYS=1
#    Spring cron 表达式；默认每日 03:30 清理过期导出文件。
SPMS_EXPORT_FILE_RETENTION_CLEANUP_CRON=0 30 3 * * *

# 7. 告警通知链路（生产 alertmanager 启动时自动渲染进配置，改这里即可换通知地址）
#    填钉钉/企微/飞书群机器人适配器或自研告警网关的 webhook 地址；
#    此值没有默认地址；未配置时生产编排必须拒绝启动，避免告警静默丢失。
#    配好后一条命令实测触达：pnpm alert:test
KUBO_ALERT_WEBHOOK_URL=
