# =============================================================================
# Kubo 生产环境变量示例配置
# 部署前请复制为 .env：cp .env.production.example .env 并替换所有密码凭据！
# =============================================================================

# 1. 外部暴露端口
WEB_PORT=80

# 2. 数据库配置 (MySQL 8.0)
# 敏感值故意不提供可用默认值；执行 `pnpm docker:env` 生成随机值，或由 Secret Manager 注入。
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env
MYSQL_DATABASE=kubo
MYSQL_USER=kubo
MYSQL_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 3. 缓存配置 (Redis 7.2)
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 4. JWT 强随机安全密钥（执行 `pnpm docker:env` 生成 64 位十六进制值）
JWT_SECRET=CHANGE_ME_GENERATE_WITH_pnpm_docker_env

# 5. 数据权限运行档位（零改码档位开关，application-production.yml 显式占位符绑定）
#    shadow  —— 默认档：全量影子比对收集放量证据（当前仓库默认）；
#    enforce —— 放量完成档：白名单 6 资源进入强管控，启动期闸门用真实证据复核；
#    off     —— 紧急回滚档：一键关闭全部拦截，恢复旧行为（无需改代码重新构建）。
DATA_PERMISSION_MODE=shadow

# 6. 告警通知链路（生产 alertmanager 启动时自动渲染进配置，改这里即可换通知地址）
#    填钉钉/企微/飞书群机器人适配器或自研告警网关的 webhook 地址；
#    此值没有默认地址；未配置时生产编排必须拒绝启动，避免告警静默丢失。
#    配好后一条命令实测触达：pnpm alert:test
KUBO_ALERT_WEBHOOK_URL=
